{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "nodenext",
    "noImplicitAny": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "removeComments": true,
    "forceConsistentCasingInFileNames": true
  },
  "lib": ["esnext"],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
